# Cursor API Key
# Get your key from https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=your-api-key-here

# Ripgrep binary path (for local file search)
# Find with: which rg
RIPGREP_PATH=/usr/bin/rg

# Set to "true" to disable truncation of debug log messages
# SDK_EVAL_NO_TRUNCATE=true

# Skip expensive tests (Meditate, Integration) — defaults to true.
# Set to "false" to run them: SDK_EVAL_SKIP_EXPENSIVE=false pnpm test
SDK_EVAL_SKIP_EXPENSIVE=true

# Global max test execution duration in milliseconds (default: 3600000 = 60 minutes).
# After this duration, all tests and agents are terminated with last known state logged.
# SDK_EVAL_MAX_DURATION_MS=3600000
